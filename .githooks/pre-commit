#!/usr/bin/env bash
# Blocks commits that contain secrets. Enable with: git config core.hooksPath .githooks
if ! command -v gitleaks >/dev/null 2>&1; then
  echo "gitleaks not installed (brew install gitleaks). Commit blocked." >&2
  exit 1
fi
exec gitleaks git --staged --redact --no-banner --config "$(git rev-parse --show-toplevel)/.gitleaks.toml"
